# Variable names only: this file carries no value. Copy it to `.env` and fill in
# the providers you measure, then export the variables in your shell before
# running aicm. aicm does NOT read this file (or `.env`) by itself — it reads the
# process environment, and aicm.toml only names the variable to read.
#
# Keep values out of aicm.toml and out of Git: `.env` is in .gitignore.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
